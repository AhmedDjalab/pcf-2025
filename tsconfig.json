{
  "compilerOptions": {
    "target": "ESNext",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
   

    "noEmit": true,
    "noImplicitAny": false,
    "jsx": "react-jsx",
    "baseUrl": "./",
  },
  "include": [
    "src",
     "src/custom.d.ts",
     "./node_modules/react-image-editor/src/index.d.ts"
  ],
  
}
